# One server serves HTTP, the frontend and WebSocket signaling.
PORT=3000
HOST=0.0.0.0
# Set to the HTTPS origin reachable from BOTH devices for phone testing/deployment.
# PUBLIC_URL=https://drop.example.com
# Phone testing with automatic temporary HTTPS: npm run dev:mobile
# MOBILE_PORT=3001
ROOM_TTL=600000
MAX_FILE_SIZE=209715200
MAX_SESSION_BYTES=209715200
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=
# Public deployment: coturn use-auth-secret / matching static-auth-secret.
# TURN_SECRET=at-least-32-random-characters-kept-server-side
# TURN_CREDENTIAL_TTL=3600
# Trust exactly this many reverse proxies. Leave 0 for direct access.
TRUST_PROXY=0
# JOIN_RATE_LIMIT=10
